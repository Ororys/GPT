{
  "private": true,
  "name": "health-convergence",
  "version": "3.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "env:init": "node scripts/gen-env.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/test_units.mjs tests/test_live_report.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:pg": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/test_pg_boundary.mjs tests/test_pg_import.mjs tests/test_http_api.mjs tests/test_migrations.mjs",
    "test:e2e": "node --env-file-if-exists=.env --test tests/e2e/demo.e2e.mjs",
    "test:all": "npm run test:unit && npm run test:pg && npm run test:e2e",
    "personal:install": "npm ci --prefix apps/personal",
    "personal:dev": "npm --prefix apps/personal run dev",
    "personal:build": "npm --prefix apps/personal run build",
    "personal:start": "npm --prefix apps/personal run start",
    "personal:test": "npm --prefix apps/personal run test",
    "personal:env": "npm --prefix apps/personal run env:init",
    "personal:db:up": "npm --prefix apps/personal run db:up",
    "personal:db:prepare": "npm --prefix apps/personal run db:prepare",
    "personal:test:pg": "npm --prefix apps/personal run test:pg"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
