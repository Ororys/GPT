{
  "name": "@health-convergence/personal",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:init": "node scripts/env-init.mjs",
    "db:up": "docker compose --env-file .env.database up -d --wait",
    "db:prepare": "node --env-file=.env.database --env-file=.env.local --import tsx scripts/database.ts",
    "test:pg": "tsx --test tests/postgres.integration.ts",
    "test:e2e:pg": "tsx scripts/e2e-postgres.ts",
    "test:storage-http": "tsx --test tests/storage-http.integration.ts",
    "identity:link": "node --env-file=.env.database --import tsx scripts/link-identity.ts",
    "test:e2e:oidc": "tsx scripts/e2e-oidc.ts",
    "test:backup": "tsx --test tests/backup.integration.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capgo/capacitor-health": "8.11.14",
    "@fontsource-variable/inter": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "echarts": "^6.0.0",
    "jose": "6.2.17",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "unpdf": "^2.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
